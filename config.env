# sLLM common environment configuration -- cluster nodes, toolchain, shared
# assets ONLY. Model information (identity, geometry, weights location)
# lives in recipes/*.yaml (paths.local_dir), never here.
#
# Precedence: real environment variable > this file > code default.
# Same file on head and worker; per-node differences (SLLM_PAIR_IFACE,
# SLLM_HEAD_PAIR_IP vs SLLM_WORKER_PAIR_IP roles) are handled by the code
# reading both sides, or by exporting real environment variables on the node
# before launch (they win over this file).
# Read by env_config.py, sllm, build.sh, entrypoint.sh and the bench/
# deploy scripts. No secrets in this file.

# ---- cluster nodes (docs/design/08-cluster-layout.md) ----------------------
SLLM_HEAD_IP=192.168.0.250
SLLM_WORKER_IP=192.168.0.231
SLLM_HEAD_PAIR_IP=10.100.25.1
SLLM_WORKER_PAIR_IP=10.100.25.2
# pair-link NIC name on THIS node (fill in; used by bench/probe_pair_link.sh
# and exported as NCCL_SOCKET_IFNAME inside the container by entrypoint.sh)
SLLM_PAIR_IFACE=

# ---- serving ----------------------------------------------------------------
# bind address for HTTP serving when the recipe does not set defaults.host.
# `sllm <recipe>` serves on the RECIPE defaults.host/defaults.port (CLI --host
# --port win); serve_standard/dev-stub fall back to these env values.
# empty = 0.0.0.0 (all interfaces)
SLLM_HOST=
SLLM_PORT=8002
# container image the `sllm` launcher runs (built by deploy/run.sh build)
SLLM_IMAGE=sllm-node:latest
# max model weights (GiB) allowed per node when overriding to a lower tp
# (serving/main.py _check_nodes; 119 GiB = 128 GB pool minus OS/overhead)
SLLM_NODE_WEIGHT_BUDGET_GIB=110

# ---- toolchain ---------------------------------------------------------------
# nvcc target for kernels/cuda/build.sh ("native" or an arch like sm_121)
NVCC_ARCH=native

# ---- shared assets (not model weights) --------------------------------------
# Qwen3.8 tokenizer snapshot directory on THIS node (tokenizer.json etc.).
# Empty = fall back to the built-in dev-machine default (tests skip without).
Q27B_TOKENIZER_DIR=
